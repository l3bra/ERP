# Автозапуск API при загрузке сервера (systemd).
# Установка:
#   1) скопируйте проект, например, в /opt/erp
#   2) отредактируйте ниже WorkingDirectory, ExecStart, User/Group
#   3) sudo cp deploy/erp-warehouse.service /etc/systemd/system/
#   4) sudo systemctl daemon-reload
#   5) sudo systemctl enable --now erp-warehouse
#
# После этого API доступен на http://127.0.0.1:8000/ (браузер не открывается).

[Unit]
Description=ERP Warehouse API (FastAPI + SQLite)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/erp
ExecStart=/opt/erp/start_server.sh
Restart=on-failure
RestartSec=5

# Пользователь, под которым работает сервис (создайте при необходимости):
#   sudo useradd --system --home-dir /opt/erp --shell /usr/sbin/nologin erp
User=erp
Group=erp

[Install]
WantedBy=multi-user.target
